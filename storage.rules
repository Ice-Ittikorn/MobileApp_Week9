rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // รูปประกาศขาย: ใครก็อ่านได้ แต่เขียนได้เฉพาะเจ้าของโฟลเดอร์ (listings/{uid}/...)
    match /listings/{sellerId}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == sellerId;
    }
  }
}
